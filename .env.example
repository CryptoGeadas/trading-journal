# Trading Journal — Environment Configuration
# Copy this file to .env and adjust as needed.

# Server
# 127.0.0.1 = only this computer can open the journal. Change it only if you
# need it on other devices, and then also set AUTH_USER and AUTH_PASS.
HOST=127.0.0.1
PORT=8000

# Data folder (optional — default is ~/.trading-journal in your user profile)
# TRADING_JOURNAL_DATA_DIR=

# Sync interval (hours) — how often to pull new trades from exchanges
SYNC_INTERVAL_HOURS=6

# Default display preferences
DEFAULT_QUOTE_CURRENCY=USDT
DEFAULT_PNL_METHOD=fifo

# Authentication (optional — leave empty for no auth)
AUTH_USER=
AUTH_PASS=

# Auto-backup retention (number of backups to keep)
BACKUP_RETENTION_COUNT=7
